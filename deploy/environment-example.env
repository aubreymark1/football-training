# Template only; create /etc/football-training.env with restricted permissions.
TEAM_DATA_DIR=/var/lib/football-training
TEAM_HTTPS=1
TEAM_TRUST_PROXY=1
# Replace with a unique random value of at least 32 characters.
TEAM_SECRET=REPLACE_WITH_RANDOM_SECRET_BEFORE_USE
